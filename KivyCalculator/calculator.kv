
<Calculator>:
    orientation: "vertical"
    padding: 10
    spacing: 8

    BoxLayout:
        size_hint_y: 0.22

        Label:
            text: root.display if root.display else "0"
            font_size: 36
            halign: "right"
            valign: "middle"
            text_size: self.size

    GridLayout:
        cols: 4
        spacing: 8

        Button:
            text: "7"
            on_press: root.add_to_display(self.text)

        Button:
            text: "8"
            on_press: root.add_to_display(self.text)

        Button:
            text: "9"
            on_press: root.add_to_display(self.text)

        Button:
            text: "/"
            on_press: root.add_to_display(self.text)

        Button:
            text: "4"
            on_press: root.add_to_display(self.text)

        Button:
            text: "5"
            on_press: root.add_to_display(self.text)

        Button:
            text: "6"
            on_press: root.add_to_display(self.text)

        Button:
            text: "*"
            on_press: root.add_to_display(self.text)

        Button:
            text: "1"
            on_press: root.add_to_display(self.text)

        Button:
            text: "2"
            on_press: root.add_to_display(self.text)

        Button:
            text: "3"
            on_press: root.add_to_display(self.text)

        Button:
            text: "-"
            on_press: root.add_to_display(self.text)

        Button:
            text: "C"
            on_press: root.clear_display()

        Button:
            text: "0"
            on_press: root.add_to_display(self.text)

        Button:
            text: "="
            on_press: root.calculate()

        Button:
            text: "+"
            on_press: root.add_to_display(self.text)
